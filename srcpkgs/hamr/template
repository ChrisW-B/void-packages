# Template file for 'hamr'
pkgname=hamr
version=1.0.0
revision=1
build_style=cargo
make_install_args="--path crates/hamr-core"
hostmakedepends="python3 pkg-config"
makedepends="gtk4-devel gtk4-layer-shell-devel "
short_desc="An extensible launcher for Hyprland and Niri built with Quickshell"
maintainer="Chris Barry <blue.iron1752@chrisb.xyz>"
license="GPL-3.0-or-later"
homepage="https://hamr.run"
