do_install() {
    vbin target/${RUST_TARGET}/release/hamr
    vbin target/${RUST_TARGET}/release/hamr-daemon
    vbin target/${RUST_TARGET}/release/hamr-gtk
    vbin target/${RUST_TARGET}/release/hamr-tui
}
